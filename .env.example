# Frontend — copy to `.env.local`

# Production API (no trailing slash)
REACT_APP_API_URL=https://ruvali.co.in

# Must match `stores.slug` in MySQL (multi-store JWT scope)
REACT_APP_STORE_SLUG=ruvali

# Prefer local ruvali-backend (e.g. http://localhost:5005) instead of REACT_APP_API_URL
# REACT_APP_USE_LOCAL_API=true

# Optional (development UX)
# REACT_APP_SHOW_TEST_PAYMENT_BANNER=true
